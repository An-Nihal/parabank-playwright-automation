# ParaBank base URL. Override to point the suite at a local ParaBank instance.
BASE_URL=https://parabank.parasoft.com

# The static customer the suite falls back to when it cannot register one and
# the customer pool is empty. john/demo is the customer ParaBank seeds itself, so
# it survives the periodic resets of the public demo database that delete every
# registered customer (ENV-05 in docs/DEFECTS.md).
STATIC_USERNAME=john
STATIC_PASSWORD=demo
