# ParaBank base URL. Override to point the suite at a local ParaBank instance.
BASE_URL=https://parabank.parasoft.com

# TD_USER_01 - the single static customer the suite logs in as.
# The setup project registers this customer automatically if the login fails,
# so the suite self-heals when Parasoft resets the public demo database.
STATIC_USERNAME=parabank_qa01
STATIC_PASSWORD=Test@1234
